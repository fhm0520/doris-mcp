# FE 地址
DORIS_HOST=127.0.0.1
# MySQL 端口
DORIS_PORT=9030
# 登录账号
DORIS_USER=root
# 登录密码
DORIS_PASSWORD=
# 默认库
DORIS_DATABASE=

# 建连超时（秒）
DORIS_CONNECT_TIMEOUT=10
# 查询超时（秒）
DORIS_QUERY_TIMEOUT=60
# 连接池大小
DORIS_POOL_SIZE=4
# 断连重试次数
DORIS_RETRIES=2
# 单次最大行数
DORIS_MAX_ROWS=200
# 单次最大字节数
DORIS_MAX_RESULT_BYTES=1000000

# 传输方式：stdio / streamable-http
MCP_TRANSPORT=stdio
# HTTP 监听地址
MCP_HOST=127.0.0.1
# HTTP 监听端口
MCP_PORT=3000
# HTTP 端点路径
MCP_PATH=/mcp

# 日志级别
LOG_LEVEL=INFO

# 本服务固定只读，写语句会被拒绝
